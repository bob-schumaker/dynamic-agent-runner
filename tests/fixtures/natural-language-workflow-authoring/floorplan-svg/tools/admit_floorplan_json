#!/usr/bin/env python3
"""Admit only complete floorplan JSON without repairing it."""

import base64
import json
import sys


def main() -> None:
    try:
        payload = sys.stdin.buffer.read()
        value = json.loads(payload)
        if not isinstance(value, dict) or set(value) != {"walls", "rooms"}:
            raise ValueError("floorplan JSON is invalid")
        print(
            json.dumps(
                {
                    "status": "accepted",
                    "output_base64": base64.b64encode(payload).decode(),
                    "repair_report": {"category": "none"},
                },
                separators=(",", ":"),
            )
        )
    except (TypeError, ValueError, json.JSONDecodeError):
        print('{"status":"rejected"}')


if __name__ == "__main__":
    main()
