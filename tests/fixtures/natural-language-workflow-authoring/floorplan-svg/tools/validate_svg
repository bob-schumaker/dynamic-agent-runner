#!/usr/bin/env python3
"""Validate the workflow's terminal SVG without giving DAR SVG semantics."""

import sys
from xml.etree import ElementTree


def main() -> None:
    try:
        root = ElementTree.fromstring(sys.stdin.buffer.read())
        valid = root.tag.rsplit("}", 1)[-1] == "svg"
    except ElementTree.ParseError:
        valid = False
    print('{"valid":' + str(valid).lower() + "}")


if __name__ == "__main__":
    main()
