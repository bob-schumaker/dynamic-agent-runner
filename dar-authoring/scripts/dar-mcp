#!/bin/sh
# Resolve DAR's stdio MCP server identically for installed users and local-wheel
# verification. Codex runs this bundled script with the plugin root as cwd.
set -eu

if [ -n "${DAR_AUTHORING_STATE_ROOT:-}" ]; then
    if [ -L "$DAR_AUTHORING_STATE_ROOT" ]; then
        echo "dar-mcp: state root must not be a symbolic link" >&2
        exit 2
    fi
    (umask 077; mkdir -p "$DAR_AUTHORING_STATE_ROOT")
    if [ -L "$DAR_AUTHORING_STATE_ROOT" ]; then
        echo "dar-mcp: state root must not be a symbolic link" >&2
        exit 2
    fi
    chmod 700 "$DAR_AUTHORING_STATE_ROOT"
fi

if [ -z "${UV_CACHE_DIR:-}" ] && [ -n "${DAR_AUTHORING_STATE_ROOT:-}" ]; then
    export UV_CACHE_DIR="$DAR_AUTHORING_STATE_ROOT/uv-cache"
fi

if [ -z "${UV_TOOL_DIR:-}" ] && [ -n "${DAR_AUTHORING_STATE_ROOT:-}" ]; then
    export UV_TOOL_DIR="$DAR_AUTHORING_STATE_ROOT/uv-tools"
fi

case "${DAR_AUTHORING_MCP_MODE:-run}" in
    run)
        set -- --stdio
        ;;
    authoring)
        if [ -n "${DAR_AUTHORING_BROKER_SOCKET:-}" ]; then
            set -- --stdio-proxy --socket "$DAR_AUTHORING_BROKER_SOCKET"
        else
        if [ -z "${DAR_AUTHORING_MATERIAL_SET_ID:-}" ] || [ -z "${DAR_AUTHORING_PACKAGE_NAME:-}" ] || [ -z "${DAR_AUTHORING_OUTPUT_ID:-}" ]; then
            echo "dar-mcp: authoring mode requires material set, package name, and output id" >&2
            exit 2
        fi
        case "$DAR_AUTHORING_PACKAGE_NAME" in
            .*|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*)
                echo "dar-mcp: authoring package name is invalid" >&2
                exit 2
                ;;
        esac
        if [ "${#DAR_AUTHORING_PACKAGE_NAME}" -gt 64 ]; then
            echo "dar-mcp: authoring package name is invalid" >&2
            exit 2
        fi
        set -- \
            --authoring-stdio \
            --material-set-id "$DAR_AUTHORING_MATERIAL_SET_ID" \
            --package-name "$DAR_AUTHORING_PACKAGE_NAME" \
            --authoring-output-id "$DAR_AUTHORING_OUTPUT_ID"
        fi
        ;;
    *)
        echo "dar-mcp: MCP mode must be run or authoring" >&2
        exit 2
        ;;
esac

if [ -n "${DAR_AUTHORING_DAR_WHEEL:-}" ]; then
    exec uvx --from "$DAR_AUTHORING_DAR_WHEEL" dynamic-agent-runner-mcp "$@"
fi

exec uvx \
    --default-index https://artifactory.oci.oraclecorp.com/api/pypi/global-release-pypi/simple \
    --from dynamic-agent-runner==0.1.16 \
    dynamic-agent-runner-mcp \
    "$@"
